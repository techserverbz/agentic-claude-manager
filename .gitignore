# Dependencies
node_modules
**/node_modules

# Build output
dist
**/dist
build
.next
out
.vite
**/.vite
*.tsbuildinfo

# Secrets / environment
.env
.env.local
.env.*.local
**/.env
**/.env.local
!**/.env.example

# Runtime user data (projects, sessions, memory, views) — not source
server/data/

# Excalidraw canvas files (the self-contained default store) — not source
excalidraw-canvas/canvas-data/
**/canvas-data/

# Logs
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# CRM credentials for the V2 read client — never commit
server/data/crm-auth.json
server/data/crm-tokens.json

# Per-workflow folders — each holds a copy of the machine's Claude credentials,
# that workflow's session transcripts and its cache. Generated at runtime with
# absolute paths baked in, so they are this machine's, not the project's.
workflows/

# Stray scratch files from earlier tooling
*.tmp
.advrev/
